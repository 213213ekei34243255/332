# Environment variables for the staff recruitment system (set these in Render -> Environment).
# Never commit real values.

# --- Admin dashboard (/staff) ---------------------------------------------------------------
STAFF_ADMIN_PASSWORD=choose-a-long-random-passphrase     # falls back to ADMIN_API_KEY if unset
# STAFF_SECRET_KEY=                                      # optional; signs sessions (defaults to a hash of the password)

# Used when Foyer's server fronts the admin API (the Foyer /staff dashboard): trusts the real client IP it forwards.
# STAFF_PROXY_KEY=                                       # same value as STAFF_PROXY_KEY in Foyer's .env

# --- Gemini (interviewer, evaluation, voice) -------------------------------------------------
GEMINI_API_KEY=
# Optional model overrides. By default the newest suitable model your key can use is picked
# automatically from models.list(), with fallback if one is retired.
# STAFF_MODEL_TURN=      # live interview turns (fast)
# STAFF_MODEL_EVAL=      # plan + final evaluation (smart)
# STAFF_MODEL_TTS=       # interviewer voice
# STAFF_MODEL_STT=       # speech-to-text fallback
# STAFF_TTS_VOICE=Kore
# STAFF_TTS_ENABLED=1    # 0 = use the candidate's browser voice only

# --- Google SMTP (invitation emails) ---------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465                       # 465 = SSL, 587 = STARTTLS
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=                      # a 16-character Google *App Password* (needs 2-Step Verification)
SMTP_FROM_NAME=Abraham Industries Recruitment
# STAFF_SUPPORT_EMAIL=              # Reply-To address shown to applicants (defaults to SMTP_USER)
# STAFF_NOTIFY_EMAIL=               # get an email for every new application

# --- Storage ---------------------------------------------------------------------------------
# DATABASE_URL is shared with the existing app (tables are prefixed staff_). Recordings are files:
# STAFF_DATA_DIR=/var/data/staff    # defaults to /var/data/staff when a Render disk is mounted
# STAFF_MAX_RECORDING_MB=600
# STAFF_VIDEO_BPS=600000

# --- Branding / links ------------------------------------------------------------------------
# STAFF_ORG_NAME=Abraham Industries
# STAFF_PUBLIC_URL=https://three32-iycd.onrender.com   # defaults to RENDER_EXTERNAL_URL

# --- Local development only ------------------------------------------------------------------
# STAFF_AI_MOCK=1            # fake AI, no Gemini key needed
# STAFF_EMAIL_DRY_RUN=1      # log emails instead of sending
